{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "ignorePatterns": [
    "node_modules",
    ".output",
    ".nitro",
    "dist",
    "build",
    ".cache",
    ".temp",
    ".turbo",
    "bun.lock",
    "yarn.lock",
    ".DS_Store",
    "Thumbs.db",
    ".env*",
    "*.log",
    "coverage",
    ".nyc_output",
    "*.min.js",
    "*.min.css",
    ".vscode",
    ".idea",
  ],
}
